# Database driver: "sqlite" (default, zero setup, for local development) or
# "postgres" (for staging/production). See src/db/client.ts.
DB_DRIVER="sqlite"

# --- sqlite (DB_DRIVER=sqlite) ---
DB_PATH="./dev.db"

# --- postgres (DB_DRIVER=postgres) ---
# Standard connection string. Example for a local Postgres instance:
# DATABASE_URL="postgres://afrfms_app:CHANGE_ME@localhost:5432/afrfms"
DATABASE_URL=""

# Generate a strong random string for production, e.g. `openssl rand -hex 32`
JWT_SECRET="replace-this-with-a-long-random-secret"
JWT_EXPIRES_IN="8h"

PORT=4000
